# Documentation only: the server reads environment variables, not .env files.
BIND_ADDR=127.0.0.1:3000
RUST_LOG=feedback_backend=info
# Required. Supply values through environment variables or a secret manager.
DATABASE_URL=postgres://feedback:CHANGE_ME@127.0.0.1:5432/feedback
APP_ORIGIN=https://feedback.example.org
COOKIE_SECURE=true
# Generate a random value of at least 32 bytes. No shipped/default credential.
ADMIN_REVIEW_TOKEN=
